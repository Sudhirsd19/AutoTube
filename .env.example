# AutoTube Environment Variables

# Google Gemini API Key (Required for AI scriptwriting & topic generation)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Pexels API Key (Optional for free stock vertical & horizontal video clips)
# Get free key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay API Key (Optional alternative for royalty-free footage/photos)
# Get free key at: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ElevenLabs API Key (Optional: only needed if you want ElevenLabs instead of free Edge-TTS)
ELEVENLABS_API_KEY=
